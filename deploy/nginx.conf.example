# Contoh Konfigurasi Reverse Proxy Nginx untuk RME Laboratorium Medis Utama
# Letakkan di /etc/nginx/sites-available/rme.conf lalu symlink ke /etc/nginx/sites-enabled/

server {
    listen 80;
    server_name rme.labmedisutama.com; # Ganti dengan domain/subdomain klinik Anda

    client_max_body_size 50M;

    # Web App RME
    location / {
        proxy_pass http://127.0.0.1:5100;
        proxy_http_version 1.1;
        proxy_set_header Upgrade $http_upgrade;
        proxy_set_header Connection "upgrade";
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
    }

    # API Supabase Kong (Self-Hosted)
    location /api/ {
        proxy_pass http://127.0.0.1:8001/;
        proxy_http_version 1.1;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
    }
}
